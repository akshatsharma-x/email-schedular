# =============================================================================
# Outbox email scheduler -- backend configuration
# Copy to .env and adjust. Every limit below is read at boot; nothing is
# hardcoded in the source.
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info

# ----------------------------------------------------------------- HTTP ------
PORT=4000
# Where this API is reachable. Used to build the OAuth redirect URIs, so it must
# match what you registered with Google and Slack exactly.
PUBLIC_API_URL=http://localhost:4000
# Where the browser gets sent back to after login. Also the only allowed CORS origin.
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------- Postgres ------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/outbox
DB_POOL_MAX=10

# ---------------------------------------------------------------- Redis ------
REDIS_URL=redis://127.0.0.1:6379
# Namespace for every key this app writes (BullMQ + rate-limit counters).
REDIS_PREFIX=outbox

# -------------------------------------------------------- Elasticsearch ------
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=outbox-emails
# Only needed if you enabled security on your ES cluster.
# ELASTICSEARCH_USERNAME=elastic
# ELASTICSEARCH_PASSWORD=changeme

# ------------------------------------------- Throughput / rate limiting ------
# How many email jobs one worker process sends in parallel.
WORKER_CONCURRENCY=5

# Minimum gap between two sends from the SAME sender, in milliseconds.
# Enforced by an atomic Redis gate, so it holds across every worker process.
# Default 2000 = "at least 2 seconds between sends per sender".
MIN_DELAY_BETWEEN_EMAILS_MS=2000

# How long a sender's slot stays reserved while one send is in flight (on top of
# the gap). This is what keeps a sender to ONE concurrent SMTP conversation, so
# the delay above is observed between sends rather than between submissions.
# Must exceed the slowest realistic send; if a worker dies mid-send, that sender
# resumes after this long.
SEND_HOLD_MS=35000

# Per-sender hourly ceiling. A sender row may override this; a campaign may
# request a lower value but never a higher one.
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# Tenant-wide hourly ceiling across all of one user's senders. 0 disables it.
MAX_EMAILS_PER_HOUR=1000

# Coarse BullMQ-level valve in front of the precise limiter: at most
# QUEUE_LIMITER_MAX jobs pulled per QUEUE_LIMITER_DURATION_MS, per worker.
QUEUE_LIMITER_MAX=50
QUEUE_LIMITER_DURATION_MS=1000

# Retry policy for transient SMTP failures (5xx responses are not retried).
SEND_MAX_ATTEMPTS=3
SEND_BACKOFF_MS=5000

# How long a worker may hold a claimed job before the reconciler assumes it died.
JOB_LEASE_MS=120000

# ------------------------------------------------------------- Recovery ------
# Rebuild the queue from Postgres at boot (covers a flushed/empty Redis).
RECONCILE_ON_BOOT=true
# Periodic divergence sweep. This is a setInterval in the worker, not a cron job,
# and it never decides when an email sends.
RECONCILE_INTERVAL_MS=60000

# ----------------------------------------------------------------- Auth ------
# Generate one with: openssl rand -hex 32
JWT_SECRET=replace-me-with-at-least-16-chars
SESSION_COOKIE_NAME=outbox_session
SESSION_TTL_HOURS=168

# Google OAuth -- https://console.cloud.google.com/apis/credentials
#   1. Create an OAuth 2.0 Client ID of type "Web application"
#   2. Authorised redirect URI: http://localhost:4000/api/auth/google/callback
#   3. Paste the client id/secret below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local development only: enables POST /api/auth/dev-login so the dashboard can
# be used before Google credentials exist. Env validation REFUSES to boot with
# this set to true while NODE_ENV=production.
DEV_AUTH_BYPASS=false

# ---------------------------------------------------------------- Slack ------
# https://api.slack.com/apps -> Create New App -> From scratch
#   1. OAuth & Permissions -> Redirect URLs: http://localhost:4000/api/slack/callback
#   2. Scopes (Bot Token Scopes): incoming-webhook, chat:write
#   3. Paste the client id/secret below. Installation happens from the dashboard.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Defaults to PUBLIC_API_URL/api/slack/callback if left blank.
SLACK_REDIRECT_URI=
SLACK_SCOPES=incoming-webhook,chat:write

# ---------------------------------------------------------------- Admin ------
# Live BullMQ dashboard. Gated on the same session cookie as the API.
BULLBOARD_ENABLED=true
BULLBOARD_PATH=/admin/queues
